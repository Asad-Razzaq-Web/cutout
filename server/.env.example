PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/cutout
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# "removebg" or "clipdrop"
BG_PROVIDER=removebg
REMOVEBG_API_KEY=
# auto = preview quality (free), full = up to 50MP (uses paid credits)
REMOVEBG_SIZE=auto
CLIPDROP_API_KEY=

# Prefix for stored file URLs. Leave empty when the API is served from the same origin as the site.
PUBLIC_BASE_URL=
MAX_FILE_MB=10
